server {
    listen 20080 ssl;
    listen [::]:20080 ssl;
    server_name auth.missdrop.cn https.missdrop.cn;
    ssl_certificate /etc/letsencrypt/live/https.missdrop.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/https.missdrop.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 2m;
    location /internal/ { deny all; }
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
